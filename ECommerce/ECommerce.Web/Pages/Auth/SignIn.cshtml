@page
@model ECommerce.Web.Pages.Auth.SignInModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="py-5" style="background-color:#f8f9fa; min-height:70vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">
                        <h2 class="mb-2 text-center">Đăng nhập</h2>
                        <p class="text-muted text-center mb-4">Chào mừng bạn quay lại. Vui lòng đăng nhập để tiếp tục.</p>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        @if (Model.SignedOut)
                        {
                            <div class="alert alert-success" role="status">Bạn đã đăng xuất thành công.</div>
                        }

                        <form method="post" novalidate>
                            <input type="hidden" asp-for="ReturnUrl" />
                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label"></label>
                                <input asp-for="Input.Email" class="form-control" placeholder="email@example.com" autocomplete="email" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="Input.Password" class="form-label"></label>
                                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn w-100" style="background-color:#d35400;color:#ffffff;border-color:#d35400;">
                                Đăng nhập
                            </button>
                        </form>

                        <div class="text-center mt-3">
                            <span class="text-muted">Chưa có tài khoản?</span>
                            <a href="/Auth/SignUp" class="text-decoration-none ms-1">Đăng ký</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
