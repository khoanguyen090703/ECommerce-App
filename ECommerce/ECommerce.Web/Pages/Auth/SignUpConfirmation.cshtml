@page
@model ECommerce.Web.Pages.Auth.SignUpConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đăng ký";
}

<section class="py-5" style="background-color:#f8f9fa; min-height:70vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="mb-3 text-success" style="font-size:2.5rem;" aria-hidden="true">✓</div>
                        <h2 class="mb-3">Đăng ký thành công</h2>
                        <p class="text-muted mb-2">
                            Cảm ơn bạn đã tạo tài khoản tại <strong>Aura Mystique</strong>.
                        </p>
                        <p class="text-muted mb-4">
                            Chúng tôi đã gửi email xác nhận tới <strong class="text-dark">@Model.Email</strong>.
                            Vui lòng mở hộp thư và bấm vào liên kết để kích hoạt tài khoản trước khi đăng nhập.
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                        {
                            <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success") mb-4 text-start" role="status">
                                @Model.StatusMessage
                            </div>
                        }

                        <div class="d-grid gap-2"
                             id="confirmation-root"
                             data-cooldown-seconds="@Model.ResendCooldownSeconds">
                            <form method="post" asp-page-handler="Resend" class="d-grid" id="resend-form">
                                <button type="submit"
                                        class="btn btn-outline-primary"
                                        id="resend-btn"
                                        disabled="@(Model.ResendCooldownSeconds > 0)">
                                    Gửi lại email xác nhận
                                </button>
                            </form>
                            <p class="small text-muted mb-0" id="resend-hint" style="min-height:1.25rem;"></p>
                            <a class="btn" asp-page="/Auth/SignIn" style="background-color:#d35400;color:#ffffff;border-color:#d35400;">
                                Đã xác nhận email? Đăng nhập
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const root = document.getElementById("confirmation-root");
            const btn = document.getElementById("resend-btn");
            const hint = document.getElementById("resend-hint");
            if (!root || !btn || !hint) return;

            let seconds = parseInt(root.dataset.cooldownSeconds || "0", 10);
            if (!Number.isFinite(seconds) || seconds < 0) seconds = 0;

            function formatSeconds(value) {
                const minutes = Math.floor(value / 60);
                const remainder = value % 60;
                return (minutes > 0 ? minutes + " phút " : "") + remainder + " giây";
            }

            function render() {
                if (seconds <= 0) {
                    btn.disabled = false;
                    hint.textContent = "";
                    return;
                }

                btn.disabled = true;
                hint.textContent = "Bạn có thể gửi lại sau " + formatSeconds(seconds) + ".";
            }

            render();
            if (seconds > 0) {
                const timerId = setInterval(function () {
                    seconds -= 1;
                    if (seconds <= 0) {
                        clearInterval(timerId);
                    }
                    render();
                }, 1000);
            }
        })();
    </script>
}
