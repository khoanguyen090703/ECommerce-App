    <div class="preloader-wrapper">
        <div class="preloader">
        </div>
    </div>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        @* Shopping Cart *@
        <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasCart" aria-labelledby="My Cart">
            <div class="offcanvas-header justify-content-center">
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <div class="order-md-last">
                    <h4 class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-primary">Your cart</span>
                        <span class="badge bg-primary rounded-pill">3</span>
                    </h4>
                    <ul class="list-group mb-3">
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <div>
                                <h6 class="my-0">Growers cider</h6>
                                <small class="text-body-secondary">Brief description</small>
                            </div>
                            <span class="text-body-secondary">$12</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <div>
                                <h6 class="my-0">Fresh grapes</h6>
                                <small class="text-body-secondary">Brief description</small>
                            </div>
                            <span class="text-body-secondary">$8</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <div>
                                <h6 class="my-0">Heinz tomato ketchup</h6>
                                <small class="text-body-secondary">Brief description</small>
                            </div>
                            <span class="text-body-secondary">$5</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Total (USD)</span>
                            <strong>$20</strong>
                        </li>
                    </ul>

                    <button class="w-100 btn btn-primary btn-lg" type="submit">Continue to checkout</button>
                </div>
            </div>
        </div>
    }

    @* Search bar *@
    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasSearch" aria-labelledby="Search">
        <div class="offcanvas-header justify-content-center">
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="order-md-last">
                <h4 class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-primary">Search</span>
                </h4>
                <form role="search" action="index.html" method="get" class="d-flex mt-3 gap-0">
                    <input class="form-control rounded-start rounded-0 bg-light" type="email" placeholder="What are you looking for?" aria-label="What are you looking for?">
                    <button class="btn btn-dark rounded-end rounded-0" type="submit">Search</button>
                </form>
            </div>
        </div>
    </div>

    @* Header: logo, search, user area (login/name/avatar), cart icon with badge *@
    <header class="site-header py-3" style="background-color:#0b1f3a; border-bottom:1px solid rgba(255,255,255,0.06);">
        <div class="container-fluid">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <!-- Logo -->
                <div class="header-logo d-flex align-items-center">
                    <a class="d-flex align-items-center text-decoration-none" href="@Url.Content("~/")">
                        <img src="@Url.Content("~/images/logo.png")" alt="logo" style="height:144px;" />
                    </a>
                </div>

                <!-- Search -->
                <div class="flex-grow-1 px-3">
                    <form class="d-flex" method="get" action="/Search">
                        <input name="q" class="form-control rounded-start rounded-0" type="search" placeholder="Search products, brands..." aria-label="Search">
                        <button class="btn rounded-end rounded-0 ms-1" type="submit" style="background-color:#d35400;color:#ffffff;border-color:#d35400;">Search</button>
                    </form>
                </div>

                <!-- User + Cart -->
                <div class="d-flex align-items-center gap-3">
                    @{
                        var cartCount = (ViewBag.CartItemCount as int?) ?? 0;
                        var isAuthenticated = User?.Identity?.IsAuthenticated == true;
                        var hardcodedFullName = "Nguyen Van A";
                        var hardcodedEmail = "nguyenvana@example.com";
                        var userName = isAuthenticated
                            ? (User?.Identity?.Name ?? User?.FindFirst("email")?.Value ?? "User")
                            : null;
                        var defaultAvatarUrl = Url.Content("~/images/avatar.webp");
                        var avatarUrl = string.IsNullOrWhiteSpace(User?.FindFirst("picture")?.Value)
                            ? defaultAvatarUrl
                            : User.FindFirst("picture")!.Value;
                    }

                    <div class="user-area d-flex align-items-center gap-2">
                        @if (isAuthenticated)
                        {
                            <div class="avatar-menu-wrapper" id="avatarMenuWrapper">
                                <button type="button" class="avatar-trigger d-flex align-items-center text-decoration-none" id="avatarTrigger" aria-label="Open profile menu">
                                    <img src="@avatarUrl" alt="avatar" class="rounded-circle" style="width:38px;height:38px;object-fit:cover;border:2px solid rgba(255,255,255,0.25);" />
                                </button>

                                <div class="avatar-hover-info">
                                    <div class="avatar-hover-name">@hardcodedFullName</div>
                                    <div class="avatar-hover-email">@hardcodedEmail</div>
                                </div>

                                <div class="avatar-popup" id="avatarPopup">
                                    <button type="button" class="avatar-popup-close" id="avatarPopupClose" aria-label="Close popup">&times;</button>
                                    <div class="avatar-popup-email">@hardcodedEmail</div>
                                    <div class="text-center mb-3">
                                        <img src="@avatarUrl" alt="avatar popup" class="rounded-circle" style="width:58px;height:58px;object-fit:cover;border:2px solid #e5e7eb;" />
                                    </div>
                                    <div class="text-center fw-semibold mb-3">Hello @hardcodedFullName</div>
                                    <button type="button" class="btn btn-outline-danger w-100">Sign out</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="btn" href="/Auth/SignIn" style="background-color:#d35400;color:#ffffff;border-color:#d35400;">Sign In</a>
                        }
                    </div>

                    @if (isAuthenticated)
                    {
                        <div>
                            <button class="btn btn-link position-relative text-white" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasCart" aria-controls="offcanvasCart">
                                <svg class="icon" width="24" height="24" role="img" aria-hidden="true"><use xlink:href="#cart"></use></svg>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">@cartCount</span>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <nav class="navbar navbar-expand py-0 mt-3 border-top" style="border-color: rgba(255,255,255,0.12) !important;">
                <ul class="navbar-nav gap-3 pt-3">
                    <li class="nav-item">
                        <a class="nav-link text-white px-0" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white px-0" asp-page="/ProductVariants/ProductVariantsList">Shop</a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
            @RenderBody()
        </main>

    <footer class="py-5 mt-5" style="background-color: var(--light-grey-color); border-top: 1px solid var(--grey-color);">
        <div class="container">
            <div class="row">
            
                <div class="col-md-4 mb-4">
                    <h5 class="mb-3" style="color: var(--dark-color); font-family: var(--heading-font);">AURA MYSTIQUE</h5>
                    <p style="color: var(--bs-body-color); line-height: var(--bs-body-line-height);">
                        Đánh thức mọi giác quan với những hương thơm mang vẻ đẹp sang trọng và huyền bí.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="mb-3" style="color: var(--dark-color); font-family: var(--heading-font);">Liên Kết</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="#" style="color: var(--bs-body-color); text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--accent-color)'" onmouseout="this.style.color='var(--bs-body-color)'">Trang chủ</a>
                        </li>
                        <li class="mb-2">
                            <a href="#" style="color: var(--bs-body-color); text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--accent-color)'" onmouseout="this.style.color='var(--bs-body-color)'">Bộ sưu tập</a>
                        </li>
                        <li class="mb-2">
                            <a href="#" style="color: var(--bs-body-color); text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--accent-color)'" onmouseout="this.style.color='var(--bs-body-color)'">Về chúng tôi</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="mb-3" style="color: var(--dark-color); font-family: var(--heading-font);">Liên Hệ</h5>
                    <ul class="list-unstyled" style="color: var(--bs-body-color);">
                        <li class="mb-2">📍 123 Tên Đường, Quận 1, TP. HCM</li>
                        <li class="mb-2">📞 0123 456 789</li>
                        <li class="mb-2">✉️ contact@auramystique.com</li>
                    </ul>
                </div>

            </div>

            <div class="row mt-4 pt-4" style="border-top: 1px solid var(--grey-color);">
                <div class="col-12 text-center">
                    <p class="mb-0" style="color: var(--light-dark-color); font-size: 0.9rem;">
                        &copy; 2026 Aura Mystique. All rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </footer>

        <script src="~/js/jquery-1.11.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
        <script src="~/js/plugins.js"></script>
        <script src="~/js/script.js"></script>
        <script>
            (function () {
                const avatarTrigger = document.getElementById("avatarTrigger");
                const avatarPopup = document.getElementById("avatarPopup");
                const avatarPopupClose = document.getElementById("avatarPopupClose");
                const avatarMenuWrapper = document.getElementById("avatarMenuWrapper");

                if (!avatarTrigger || !avatarPopup || !avatarMenuWrapper) {
                    return;
                }

                avatarTrigger.addEventListener("click", function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    avatarPopup.classList.toggle("show");
                });

                if (avatarPopupClose) {
                    avatarPopupClose.addEventListener("click", function (event) {
                        event.stopPropagation();
                        avatarPopup.classList.remove("show");
                    });
                }

                document.addEventListener("click", function (event) {
                    if (!avatarMenuWrapper.contains(event.target)) {
                        avatarPopup.classList.remove("show");
                    }
                });
            })();
        </script>
        @await RenderSectionAsync("Scripts", required: false)
</body>

</html>