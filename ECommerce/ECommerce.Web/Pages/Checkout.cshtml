@page "/checkout"
@model ECommerce.Web.Pages.CheckoutModel
@using ECommerce.Web.Helpers
@{
    ViewData["Title"] = "Thanh toán";
    var checkout = Model.Checkout;
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Thanh toán</h1>
            <div class="text-muted">Hoàn tất thông tin giao hàng và xác nhận đơn hàng.</div>
        </div>
        <a class="btn btn-outline-secondary" asp-page="/ProductVariants/ProductVariantsList">Tiếp tục mua sắm</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }

    @if (checkout is null)
    {
        <div class="text-center text-muted py-5">Không tải được thông tin thanh toán.</div>
    }
    else if (checkout.CartItems.Count == 0)
    {
        <div class="text-center py-5">
            <p class="text-muted mb-3">Giỏ hàng của bạn đang trống.</p>
            <a class="btn btn-primary" asp-page="/ProductVariants/ProductVariantsList">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Thông tin giao hàng</h2>

                        <form method="post" asp-page-handler="PlaceOrder" novalidate>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input class="form-control" type="email" value="@checkout.Email" readonly />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.RecipientName" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="Input.RecipientName" class="form-control" autocomplete="name" />
                                <span asp-validation-for="Input.RecipientName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="Input.PhoneNumber" class="form-control" type="tel" autocomplete="tel" placeholder="VD: 0901234567" />
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Input.ProvinceCode" class="form-label">Tỉnh/Thành phố <span class="text-danger">*</span></label>
                                    <select asp-for="Input.ProvinceCode" class="form-select" id="province">
                                        <option value="">Chọn tỉnh/thành</option>
                                        @foreach (var province in Model.Provinces)
                                        {
                                            <option value="@province.Code">@province.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Input.ProvinceCode" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Input.DistrictCode" class="form-label">Quận/Huyện <span class="text-danger">*</span></label>
                                    <select asp-for="Input.DistrictCode" class="form-select" id="district" disabled="@(Model.Districts.Count == 0)">
                                        <option value="">Chọn quận/huyện</option>
                                        @foreach (var district in Model.Districts)
                                        {
                                            <option value="@district.Code">@district.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Input.DistrictCode" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Input.WardCode" class="form-label">Phường/Xã <span class="text-danger">*</span></label>
                                    <select asp-for="Input.WardCode" class="form-select" id="ward" disabled="@(Model.Wards.Count == 0)">
                                        <option value="">Chọn phường/xã</option>
                                        @foreach (var ward in Model.Wards)
                                        {
                                            <option value="@ward.Code">@ward.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Input.WardCode" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mt-3 mb-3">
                                <label asp-for="Input.Street" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="Input.Street" class="form-control" autocomplete="street-address" placeholder="VD: 12 Nguyễn Huệ" />
                                <span asp-validation-for="Input.Street" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Phương thức thanh toán <span class="text-danger">*</span></label>
                                <div class="d-grid gap-2">
                                    @foreach (var method in checkout.PaymentMethods)
                                    {
                                        <label class="border rounded p-3 d-flex align-items-center gap-3 mb-0" style="cursor:pointer;">
                                            <input type="radio"
                                                   class="form-check-input m-0"
                                                   name="Input.PaymentMethodId"
                                                   value="@method.Id"
                                                   checked="@(Model.Input.PaymentMethodId == method.Id)" />
                                            <div class="flex-grow-1">
                                                <div class="fw-semibold">@method.Name</div>
                                            </div>
                                        </label>
                                    }
                                </div>
                                <span asp-validation-for="Input.PaymentMethodId" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Đặt hàng</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Tóm tắt đơn hàng</h2>

                        <div class="vstack gap-3">
                            @foreach (var item in checkout.CartItems)
                            {
                                <div class="d-flex gap-3 align-items-center">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="" width="56" height="56" loading="lazy" class="rounded border flex-shrink-0" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light border flex-shrink-0" style="width:56px;height:56px;"></div>
                                    }

                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold text-truncate" title="@item.ProductName">@item.ProductName</div>
                                        <div class="small text-muted">Số lượng: @item.Quantity</div>
                                    </div>

                                    <div class="text-end">
                                        <div class="fw-semibold">@WebDisplay.FormatCurrency(item.Quantity * item.UnitPrice)</div>
                                        <div class="small text-muted">@WebDisplay.FormatCurrency(item.UnitPrice) / sp</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính</span>
                            <strong>@WebDisplay.FormatCurrency(checkout.SubTotal)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển</span>
                            <strong>Miễn phí</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Tổng cộng</span>
                            <strong class="text-primary">@WebDisplay.FormatCurrency(checkout.SubTotal)</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const province = document.getElementById('province');
            const district = document.getElementById('district');
            const ward = document.getElementById('ward');
            if (!province || !district || !ward) return;

            function fillSelect(select, rows, placeholder) {
                select.innerHTML = '';
                const placeholderOption = document.createElement('option');
                placeholderOption.value = '';
                placeholderOption.textContent = placeholder;
                select.appendChild(placeholderOption);

                (rows || []).forEach(function (row) {
                    const option = document.createElement('option');
                    option.value = String(row.code ?? row.Code ?? '');
                    option.textContent = row.name ?? row.Name ?? '';
                    select.appendChild(option);
                });

                select.disabled = !(rows && rows.length);
            }

            async function loadOptions(url, select, placeholder) {
                const response = await fetch(url, {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });
                if (!response.ok) throw new Error('HTTP ' + response.status);
                const rows = await response.json();
                fillSelect(select, rows, placeholder);
            }

            province.addEventListener('change', async function () {
                const code = province.value;
                fillSelect(ward, [], 'Chọn phường/xã');
                ward.disabled = true;

                if (!code) {
                    fillSelect(district, [], 'Chọn quận/huyện');
                    district.disabled = true;
                    return;
                }

                district.disabled = true;
                fillSelect(district, [], 'Đang tải quận/huyện…');
                try {
                    await loadOptions('?handler=Districts&provinceCode=' + encodeURIComponent(code), district, 'Chọn quận/huyện');
                } catch {
                    fillSelect(district, [], 'Chọn quận/huyện');
                    district.disabled = true;
                }
            });

            district.addEventListener('change', async function () {
                const code = district.value;
                if (!code) {
                    fillSelect(ward, [], 'Chọn phường/xã');
                    ward.disabled = true;
                    return;
                }

                ward.disabled = true;
                fillSelect(ward, [], 'Đang tải phường/xã…');
                try {
                    await loadOptions('?handler=Wards&districtCode=' + encodeURIComponent(code), ward, 'Chọn phường/xã');
                } catch {
                    fillSelect(ward, [], 'Chọn phường/xã');
                    ward.disabled = true;
                }
            });
        })();
    </script>
}
