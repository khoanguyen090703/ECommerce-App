@page "/orders/{id:int:min(1)}"
@model ECommerce.Web.Pages.Orders.DetailsModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Orders/Index">← Quay lại đơn hàng của tôi</a>
    </div>

    <div id="orderDetailsLoading" class="text-center text-muted py-5">
        <span class="spinner-border me-2" role="status" aria-hidden="true"></span>Đang tải chi tiết đơn hàng...
    </div>

    <div id="orderDetailsError" class="alert alert-warning d-none" role="alert"></div>

    <div id="orderDetailsContent" class="d-none">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <h1 id="orderTitle" class="h4 mb-1">Đơn hàng</h1>
                        <div id="orderDateText" class="small text-muted">—</div>
                    </div>
                    <div class="text-end">
                        <span id="orderStatusBadge" class="badge bg-dark">Unknown</span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="small text-muted">Người nhận</div>
                        <div id="recipientName" class="fw-semibold">—</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Số điện thoại</div>
                        <div id="phoneNumber" class="fw-semibold">—</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Thanh toán</div>
                        <div id="paymentStatus" class="fw-semibold">—</div>
                    </div>
                    <div class="col-12">
                        <div class="small text-muted">Địa chỉ giao hàng</div>
                        <div id="shippingAddress" class="fw-semibold">—</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-3 p-md-4">
                <h2 class="h6 mb-3">Sản phẩm trong đơn</h2>
                <div id="orderItemsWrap" class="vstack gap-2"></div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted">Tạm tính</span>
                    <span id="subTotalValue" class="fw-semibold">—</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted">Phí vận chuyển</span>
                    <span id="shippingFeeValue" class="fw-semibold">—</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="fw-semibold">Tổng cộng</span>
                    <span id="totalAmountValue" class="fw-bold">—</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const els = {
                loading: document.getElementById('orderDetailsLoading'),
                error: document.getElementById('orderDetailsError'),
                content: document.getElementById('orderDetailsContent'),
                title: document.getElementById('orderTitle'),
                orderDateText: document.getElementById('orderDateText'),
                orderStatusBadge: document.getElementById('orderStatusBadge'),
                recipientName: document.getElementById('recipientName'),
                phoneNumber: document.getElementById('phoneNumber'),
                paymentStatus: document.getElementById('paymentStatus'),
                shippingAddress: document.getElementById('shippingAddress'),
                orderItemsWrap: document.getElementById('orderItemsWrap'),
                subTotalValue: document.getElementById('subTotalValue'),
                shippingFeeValue: document.getElementById('shippingFeeValue'),
                totalAmountValue: document.getElementById('totalAmountValue')
            };

            function show(el, yes) {
                if (!el) return;
                el.classList.toggle('d-none', !yes);
            }

            function setError(message) {
                if (!els.error) return;
                els.error.textContent = message || 'Không tải được chi tiết đơn hàng.';
                show(els.error, true);
            }

            function formatVnd(value) {
                const n = Number(value) || 0;
                try { return new Intl.NumberFormat('vi-VN').format(n) + ' ₫'; } catch { return n + ' ₫'; }
            }

            function formatDate(value) {
                if (!value) return '—';
                const d = new Date(value);
                if (Number.isNaN(d.getTime())) return '—';
                return d.toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' });
            }

            function getStatusBadgeClass(status) {
                switch ((status || '').toLowerCase()) {
                    case 'pending': return 'bg-warning text-dark';
                    case 'processing': return 'bg-info text-dark';
                    case 'shipping': return 'bg-primary';
                    case 'delivered': return 'bg-success';
                    case 'completed': return 'bg-success';
                    case 'cancelled': return 'bg-danger';
                    case 'returned': return 'bg-secondary';
                    default: return 'bg-dark';
                }
            }

            async function fetchJson(url) {
                const response = await fetch(url, {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });

                const text = await response.text();
                let data = null;
                if (text) {
                    try { data = JSON.parse(text); } catch { data = null; }
                }

                if (!response.ok) {
                    const err = new Error('HTTP ' + response.status);
                    err.status = response.status;
                    err.data = data;
                    throw err;
                }
                return data;
            }

            function createOrderItemRow(item) {
                const productName = item?.productName ?? item?.ProductName ?? '';
                const quantity = Number(item?.quantity ?? item?.Quantity ?? 0) || 0;
                const unitPrice = Number(item?.unitPrice ?? item?.UnitPrice ?? 0) || 0;
                const total = quantity * unitPrice;
                const imageUrl = item?.imageUrl ?? item?.ImageUrl ?? '';

                const row = document.createElement('div');
                row.className = 'd-flex align-items-center gap-3 border rounded p-2';
                row.innerHTML = `
                    <div class="flex-shrink-0">
                        ${imageUrl
                        ? `<img src="${imageUrl}" alt="" width="52" height="52" class="rounded border" style="object-fit:cover;" />`
                        : `<div class="rounded border bg-light" style="width:52px;height:52px;"></div>`}
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold text-truncate" title="${productName}">${productName}</div>
                        <div class="small text-muted">SL: ${quantity} • ${formatVnd(unitPrice)} / sp</div>
                    </div>
                    <div class="fw-semibold text-end">${formatVnd(total)}</div>
                `;
                return row;
            }

            function readOrderIdFromPath() {
                const segments = window.location.pathname.split('/').filter(Boolean);
                const maybeId = segments[segments.length - 1];
                const id = Number.parseInt(maybeId || '', 10);
                return Number.isFinite(id) && id > 0 ? id : null;
            }

            function renderDetails(order) {
                const id = order?.id ?? order?.Id;
                const status = order?.status ?? order?.Status ?? 'Unknown';
                const paymentStatus = order?.paymentStatus ?? order?.PaymentStatus ?? 'Unknown';
                const recipientName = order?.recipientName ?? order?.RecipientName ?? '—';
                const phoneNumber = order?.phoneNumber ?? order?.PhoneNumber ?? '—';
                const shippingAddress = order?.shippingAddress ?? order?.ShippingAddress ?? '—';
                const orderDate = order?.orderDate ?? order?.OrderDate;
                const orderItems = order?.orderItems ?? order?.OrderItems ?? [];
                const subTotal = Number(order?.subTotal ?? order?.SubTotal ?? 0) || 0;
                const shippingFee = Number(order?.shippingFee ?? order?.ShippingFee ?? 0) || 0;
                const totalAmount = Number(order?.totalAmount ?? order?.TotalAmount ?? 0) || 0;

                els.title.textContent = `Đơn hàng #${id}`;
                els.orderDateText.textContent = `Ngày đặt: ${formatDate(orderDate)}`;
                els.orderStatusBadge.className = `badge ${getStatusBadgeClass(status)}`;
                els.orderStatusBadge.textContent = status;
                els.recipientName.textContent = recipientName;
                els.phoneNumber.textContent = phoneNumber;
                els.paymentStatus.textContent = paymentStatus;
                els.shippingAddress.textContent = shippingAddress;
                els.subTotalValue.textContent = formatVnd(subTotal);
                els.shippingFeeValue.textContent = formatVnd(shippingFee);
                els.totalAmountValue.textContent = formatVnd(totalAmount);

                els.orderItemsWrap.innerHTML = '';
                if (!orderItems.length) {
                    const empty = document.createElement('div');
                    empty.className = 'text-muted';
                    empty.textContent = 'Không có sản phẩm trong đơn hàng.';
                    els.orderItemsWrap.appendChild(empty);
                } else {
                    orderItems.forEach((item) => {
                        els.orderItemsWrap.appendChild(createOrderItemRow(item));
                    });
                }
            }

            document.addEventListener('DOMContentLoaded', async function () {
                show(els.loading, true);
                show(els.error, false);
                show(els.content, false);

                try {
                    const orderId = readOrderIdFromPath();
                    if (!orderId) throw new Error('Id đơn hàng không hợp lệ.');
                    const data = await fetchJson(`/api/orders/${orderId}`);
                    renderDetails(data);
                    show(els.content, true);
                } catch (e) {
                    setError(e?.data?.message || e?.data?.error || e?.message || 'Không tải được chi tiết đơn hàng.');
                } finally {
                    show(els.loading, false);
                }
            });
        })();
    </script>
}
