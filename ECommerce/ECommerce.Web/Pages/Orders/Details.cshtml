@page "/orders/{id:int:min(1)}"
@model ECommerce.Web.Pages.Orders.DetailsModel
@using ECommerce.Web.Helpers
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Orders/Index">← Quay lại đơn hàng của tôi</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ActionError))
    {
        <div class="alert alert-warning" role="alert">@Model.ActionError</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }
    else if (Model.Order is not null)
    {
        var order = Model.Order;

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <h1 class="h4 mb-1">Đơn hàng #@order.Id</h1>
                        <div class="small text-muted">Ngày đặt: @WebDisplay.FormatDate(order.OrderDate)</div>
                    </div>
                    <div class="text-end">
                        <span class="badge @OrderStatusStyles.BadgeClass(order.Status)">@OrderStatusStyles.FormatStatus(order.Status)</span>
                        @if (string.Equals(order.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@order.Id" class="mt-2 js-cancel-order-form">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                            </form>
                        }
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="small text-muted">Người nhận</div>
                        <div class="fw-semibold">@order.RecipientName</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Số điện thoại</div>
                        <div class="fw-semibold">@order.PhoneNumber</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Thanh toán</div>
                        <div class="fw-semibold">@WebDisplay.FormatPaymentStatus(order.PaymentStatus)</div>
                    </div>
                    <div class="col-12">
                        <div class="small text-muted">Địa chỉ giao hàng</div>
                        <div class="fw-semibold">@order.ShippingAddress</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-3 p-md-4">
                <h2 class="h6 mb-3">Thời gian đơn hàng</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="small text-muted">Ngày đặt</div>
                        <div class="fw-semibold">@WebDisplay.FormatDate(order.OrderDate)</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Ngày hoàn tất</div>
                        <div class="fw-semibold">@WebDisplay.FormatDate(order.CompletedDate)</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Ngày hủy</div>
                        <div class="fw-semibold">@WebDisplay.FormatDate(order.CancelledDate)</div>
                    </div>
                </div>
            </div>
        </div>

        @if (order.CanRetryOnlinePayment)
        {
            <div class="card shadow-sm border-warning mb-3">
                <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="small">
                        <span class="fw-semibold">Thanh toán trực tuyến</span>
                        <span class="text-muted d-block">Đơn hàng chưa thanh toán xong. Bạn có thể mở lại cổng thanh toán.</span>
                    </div>
                    <form method="post" asp-page-handler="PayAgain" asp-route-id="@order.Id">
                        <button type="submit" class="btn btn-primary btn-sm">Thanh toán lại</button>
                    </form>
                </div>
            </div>
        }

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-3 p-md-4">
                <h2 class="h6 mb-3">Sản phẩm trong đơn</h2>
                @if (!order.OrderItems.Any())
                {
                    <div class="text-muted">Không có sản phẩm trong đơn hàng.</div>
                }
                else
                {
                    <div class="vstack gap-2">
                        @foreach (var item in order.OrderItems)
                        {
                            <partial name="_OrderItemRow" model="item" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted">Tạm tính</span>
                    <span class="fw-semibold">@WebDisplay.FormatCurrency(order.SubTotal)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted">Phí vận chuyển</span>
                    <span class="fw-semibold">@WebDisplay.FormatCurrency(order.ShippingFee)</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="fw-semibold">Tổng cộng</span>
                    <span class="fw-bold">@WebDisplay.FormatCurrency(order.TotalAmount)</span>
                </div>
            </div>
        </div>
    }
</div>
