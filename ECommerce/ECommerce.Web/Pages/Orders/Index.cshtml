@page "/orders"
@model ECommerce.Web.Pages.Orders.IndexModel
@using ECommerce.Web.Helpers
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Đơn hàng của tôi</h1>
            <div class="text-muted">Theo dõi trạng thái và chi tiết các đơn hàng đã đặt.</div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2">
                @foreach (var filter in Model.Filters)
                {
                    var active = string.Equals(Model.Status ?? string.Empty, filter.Key, StringComparison.OrdinalIgnoreCase);
                    <a class="btn btn-sm @(active ? "btn-dark" : "btn-outline-dark")"
                       asp-page="/Orders/Index"
                       asp-route-status="@(string.IsNullOrEmpty(filter.Key) ? null : filter.Key)"
                       asp-route-pageNumber="1">@filter.Label</a>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ActionError))
    {
        <div class="alert alert-warning" role="alert">@Model.ActionError</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }
    else if (!Model.Orders.Items.Any())
    {
        <div class="alert alert-light border" role="status">Không có đơn hàng nào phù hợp bộ lọc.</div>
    }
    else
    {
        <div class="vstack gap-3">
            @foreach (var order in Model.Orders.Items)
            {
                var firstItem = order.OrderItems.FirstOrDefault();
                var hiddenCount = Math.Max(order.OrderItems.Count - 1, 0);

                <article class="card shadow-sm border-0">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                            <div>
                                <div class="fw-bold">Đơn hàng #@order.Id</div>
                                <div class="small text-muted">Ngày đặt: @WebDisplay.FormatDate(order.OrderDate)</div>
                            </div>
                            <span class="badge @OrderStatusStyles.BadgeClass(order.Status)">@OrderStatusStyles.FormatStatus(order.Status)</span>
                        </div>

                        <div class="small text-muted mb-2">Thanh toán: <span class="fw-semibold text-dark">@WebDisplay.FormatPaymentStatus(order.PaymentStatus)</span></div>

                        @if (order.CanRetryOnlinePayment)
                        {
                            <form method="post" asp-page-handler="PayAgain" asp-route-orderId="@order.Id" class="mb-2">
                                <button type="submit" class="btn btn-sm btn-primary">Thanh toán lại</button>
                            </form>
                        }

                        @if (string.Equals(order.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-orderId="@order.Id" class="mb-2 js-cancel-order-form">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                            </form>
                        }

                        @if (firstItem is not null)
                        {
                            <partial name="_OrderItemRow" model="firstItem" />
                        }

                        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                            @if (hiddenCount > 0)
                            {
                                <span class="text-muted small">và @hiddenCount sản phẩm khác</span>
                            }
                            else
                            {
                                <span></span>
                            }

                            <div class="d-flex align-items-center gap-3">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Orders/Details" asp-route-id="@order.Id">Xem chi tiết</a>
                                <div class="fw-semibold">Tổng: @WebDisplay.FormatCurrency(order.TotalAmount)</div>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (Model.Orders.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Order pagination">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.Orders.HasPreviousPage ? string.Empty : "disabled")">
                        <a class="page-link"
                           asp-page="/Orders/Index"
                           asp-route-status="@Model.Status"
                           asp-route-pageNumber="@(Model.Orders.PageNumber - 1)">Trước</a>
                    </li>

                    @for (var pageNumber = 1; pageNumber <= Model.Orders.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Orders.PageNumber ? "active" : string.Empty)">
                            <a class="page-link"
                               asp-page="/Orders/Index"
                               asp-route-status="@Model.Status"
                               asp-route-pageNumber="@pageNumber">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.Orders.HasNextPage ? string.Empty : "disabled")">
                        <a class="page-link"
                           asp-page="/Orders/Index"
                           asp-route-status="@Model.Status"
                           asp-route-pageNumber="@(Model.Orders.PageNumber + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
