@page "/Orders/PaymentPending"
@model ECommerce.Web.Pages.Orders.PaymentPendingModel
@using ECommerce.Web.Helpers
@{
    ViewData["Title"] = "Thanh toán chưa hoàn tất";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 640px;">
        @if (!string.IsNullOrEmpty(Model.PageError))
        {
            <div class="alert alert-warning" role="alert">@Model.PageError</div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-page="/Orders/Index">Đơn hàng của tôi</a>
                <a class="btn btn-outline-secondary" asp-page="/Index">Về trang chủ</a>
            </div>
        }
        else if (Model.OrderLoaded && Model.OrderId is int oid)
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="mb-3" style="font-size: 3rem; line-height: 1;">⏸</div>
                    <h1 class="h4 mb-2">Thanh toán chưa hoàn tất</h1>
                    <p class="text-muted mb-2">
                        Đơn hàng <strong>#@oid</strong>
                        @if (Model.TotalAmount is decimal t)
                        {
                            <span> — Tổng @t.ToString("N0") ₫</span>
                        }
                    </p>
                    <p class="small text-muted mb-4">
                        Trạng thái thanh toán hiện tại: <strong>@WebDisplay.FormatPaymentStatus(Model.PaymentStatus)</strong>.
                        Bạn có thể thanh toán lại (thẻ / Stripe) nếu phương thức đơn hàng cho phép.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.ActionError))
                    {
                        <div class="alert alert-danger text-start small" role="alert">@Model.ActionError</div>
                    }
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                        @if (Model.CanRetryOnlinePayment)
                        {
                            <form method="post" asp-page-handler="PayAgain" asp-route-orderId="@oid" class="d-inline">
                                <button type="submit" class="btn btn-primary">Thanh toán lại</button>
                            </form>
                        }
                        <a class="btn btn-outline-secondary" asp-page="/Orders/Details" asp-route-id="@oid">Xem chi tiết đơn hàng</a>
                        <a class="btn btn-outline-secondary" asp-page="/Orders/Index">Đơn hàng của tôi</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
