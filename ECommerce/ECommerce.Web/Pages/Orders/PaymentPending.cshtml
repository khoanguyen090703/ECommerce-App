@page "/Orders/PaymentPending"
@model ECommerce.Web.Pages.Orders.PaymentPendingModel
@{
    ViewData["Title"] = "Thanh toán chưa hoàn tất";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 640px;">
        @if (!string.IsNullOrEmpty(Model.PageError))
        {
            <div class="alert alert-warning" role="alert">@Model.PageError</div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-page="/Orders/Index">Đơn hàng của tôi</a>
                <a class="btn btn-outline-secondary" asp-page="/Index">Về trang chủ</a>
            </div>
        }
        else if (Model.OrderLoaded && Model.OrderId is int oid)
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="mb-3" style="font-size: 3rem; line-height: 1;">⏸</div>
                    <h1 class="h4 mb-2">Thanh toán chưa hoàn tất</h1>
                    <p class="text-muted mb-2">
                        Đơn hàng <strong>#@oid</strong>
                        @if (Model.TotalAmount is decimal t)
                        {
                            <span> — Tổng @t.ToString("N0") ₫</span>
                        }
                    </p>
                    <p class="small text-muted mb-4">
                        Trạng thái thanh toán hiện tại: <strong>@(Model.PaymentStatus ?? "—")</strong>.
                        Bạn có thể thanh toán lại (thẻ / Stripe) nếu phương thức đơn hàng cho phép.
                    </p>
                    <div id="payPendingError" class="alert alert-danger d-none text-start small" role="alert"></div>
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                        @if (Model.CanRetryOnlinePayment)
                        {
                            <button type="button" class="btn btn-primary" id="btnPayPendingAgain">Thanh toán lại</button>
                        }
                        <a class="btn btn-outline-secondary" asp-page="/Orders/Details" asp-route-id="@oid">Xem chi tiết đơn hàng</a>
                        <a class="btn btn-outline-secondary" asp-page="/Orders/Index">Đơn hàng của tôi</a>
                    </div>
                </div>
            </div>

            @if (Model.CanRetryOnlinePayment)
            {
                <script>
                    (function () {
                        const orderId = @oid;
                        const errEl = document.getElementById('payPendingError');
                        const btn = document.getElementById('btnPayPendingAgain');

                        function show(el, yes) {
                            if (!el) return;
                            el.classList.toggle('d-none', !yes);
                        }

                        async function fetchJson(url, options) {
                            const res = await fetch(url, Object.assign({
                                credentials: 'same-origin',
                                headers: { 'Accept': 'application/json' }
                            }, options || {}));
                            const text = await res.text();
                            let data = null;
                            if (text) { try { data = JSON.parse(text); } catch { data = null; } }
                            if (!res.ok) {
                                const err = new Error('HTTP ' + res.status);
                                err.data = data;
                                throw err;
                            }
                            return data;
                        }

                        document.addEventListener('DOMContentLoaded', function () {
                            if (!btn) return;
                            btn.addEventListener('click', async function () {
                                show(errEl, false);
                                btn.disabled = true;
                                try {
                                    const checkout = await fetchJson('/api/payments/stripe/orders/' + orderId + '/retry', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                        body: '{}'
                                    });
                                    const url = checkout.checkoutUrl ?? checkout.CheckoutUrl;
                                    if (url) window.location.href = url;
                                    else throw new Error('Không nhận được liên kết thanh toán.');
                                } catch (e) {
                                    const msg = e?.data?.message || e?.data?.title || e?.message || 'Không tạo được phiên thanh toán.';
                                    if (errEl) errEl.textContent = msg;
                                    show(errEl, true);
                                } finally {
                                    btn.disabled = false;
                                }
                            });
                        });
                    })();
                </script>
            }
        }
    </div>
</div>
