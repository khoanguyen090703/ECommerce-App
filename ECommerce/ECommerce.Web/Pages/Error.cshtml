@page
@model ErrorModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Ứng dụng gặp sự cố khi xử lý yêu cầu của bạn.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển</h3>
<p>
    Khi chạy trong môi trường <strong>Development</strong>, hệ thống có thể hiển thị thêm chi tiết lỗi để gỡ lỗi.
</p>
<p>
    <strong>Không nên bật môi trường Development trên máy chủ thật.</strong>
    Điều này có thể lộ thông tin nhạy cảm cho người dùng cuối.
    Để gỡ lỗi cục bộ, đặt biến môi trường <strong>ASPNETCORE_ENVIRONMENT</strong> thành <strong>Development</strong>
    rồi khởi động lại ứng dụng.
</p>
