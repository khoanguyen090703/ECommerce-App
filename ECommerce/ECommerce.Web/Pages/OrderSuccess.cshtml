@page "/order-success"
@model ECommerce.Web.Pages.OrderSuccessModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 680px;">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="mb-3" style="font-size: 3rem; line-height: 1;">✅</div>
                <h1 class="h3 mb-2">Đặt hàng thành công</h1>
                <p class="text-muted mb-4">
                    Cảm ơn bạn đã mua hàng tại Aura Mystique. Đơn hàng của bạn đã được ghi nhận.
                </p>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a class="btn btn-primary" asp-page="/Index">Về trang chủ</a>
                    <a class="btn btn-outline-secondary" asp-page="/Orders/Index">Chi tiết đơn hàng</a>
                </div>
            </div>
        </div>
    </div>
</div>
